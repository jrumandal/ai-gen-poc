{
  "name": "@jrumandal/shell",
  "version": "0.0.1",
  "private": true,
  "description": "Angular SSR shell that composes the @jrumandal/catalog, @jrumandal/cart, and @jrumandal/user micro-frontends.",
  "scripts": {
    "build": "ng build",
    "serve": "ng serve",
    "start": "node dist/shell/server/server.mjs",
    "test": "jest --config jest.config.cts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/elements": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/ssr": "~22.1.0",
    "@jrumandal/cart": "workspace:*",
    "@jrumandal/catalog": "workspace:*",
    "@jrumandal/user": "workspace:*",
    "@jrumandal/bridge": "workspace:*",
    "@jrumandal/contracts": "workspace:*",
    "@jrumandal/design-tokens": "workspace:*",
    "@jrumandal/event-bus": "workspace:*",
    "@ngrx/store": "^22.0.0",
    "@ngrx/router-store": "^22.0.0",
    "@ngrx/effects": "^22.0.0",
    "@apollo/client": "^4.2.12",
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vue": "^3.5.41",
    "@vue/server-renderer": "^3.5.41",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "22.1.5",
    "@angular/language-service": "~22.1.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@schematics/angular": "~22.1.0",
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "^22.2.0",
    "eslint": "9.39.5",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "~17.0.0",
    "ts-jest": "^29.4.7",
    "typescript": "6.0.3",
