{
  "name": "contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/contracts/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/contracts",
        "main": "libs/shared/contracts/src/index.ts",
        "tsConfig": "libs/shared/contracts/tsconfig.lib.json",
        "assets": ["libs/shared/contracts/*.md"]
      }
    },
    "generate:graphql": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/shared/contracts/src/generated/graphql.ts"],
      "options": {
        "command": "graphql-codegen --config codegen.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate:api": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/shared/contracts/src/generated"],
      "options": {
        "command": "node scripts/generate-contracts.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
