# Prefer linking workspace packages (e.g. @shared/*) over fetching them from
# the npm registry. Without this, `autoInstallPeers` tries to resolve the
# `@shared/*` peerDependencies of the MF packages from the public registry and
# fails with a 404 (they are private, workspace-only packages).
link-workspace-packages=true
# Keep auto-installing peers so the Angular/React/Vue peer deps are satisfied,
# but resolve them from the workspace when a matching package exists.
auto-install-peers=true
