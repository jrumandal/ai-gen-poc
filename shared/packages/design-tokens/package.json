{
  "name": "@shared/design-tokens",
  "version": "0.0.1",
  "description": "Design tokens (CSS custom properties + typed accessors) for the micro-frontend design system. Tailwind v4 maps these tokens via @theme.",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./tokens.css",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "files": ["src", "tokens.css"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "build": "node -e \"console.log('@shared/design-tokens is source-only (no build step).')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.0"
  }
}
