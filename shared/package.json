{
  "name": "mf-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared libraries for the micro-frontend POC (design-system, contracts, event-bus, bridge)",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
